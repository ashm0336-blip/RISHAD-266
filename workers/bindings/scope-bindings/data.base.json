 "interpretations": [
  {
   "id": "I‑01",
   "title": "الفاعلُ على سقف الإدارة — مصحَّح بـD4‑04 (v24.5)",
   "text": "super · dept · مدير الإدارة (mgr:) · gm: لا يُعطَون Site/Zone = ALL بالدور؛ مديرُ الإدارة يرث سقفَ الإدارة الصريح (Department Scope Ceiling) · gm = union سقوف إدارات فرعه · super يحترم سقفَ الإدارة المستهدفة (+ Lens Ceiling + DateRange). غيابُ السقف (غيرُ مهاجر اليوم) ⇒ unknown:unmigrated-department-ceiling؛ ALL ⇒ allow · list ⇒ داخلها · outside ⇒ deny. Shift للمدير allow «المدير بلا قيد» (نصُّ v24.4 §7 — لم يتغيّر)."
  },
  {
   "id": "I‑02",
   "title": "قاعدةُ القفل الزمني للجولات والتقرير",
   "text": "سجلُّ الشهر m:y-m {ap · mo · dopen · dshut} يُقرأ بقاعدة dsLockedIn نفسِها (R183 الملاحظة ٩) ويُضاف إليه اعتمادُ اليوم/الوردية — واجهيٌّ اليوم فيُصنَّف الاختلافُ expected:locked-period."
  },
  {
   "id": "I‑03",
   "title": "الجدولُ الشهري والمهام",
   "text": "القفلُ الصريح locks[y-m] === true فقط؛ {mo:1} = مفتوح؛ غيابُ مورد الأقفال عن السياق = unknown:lock-evidence-missing (لا deny)."
  },
  {
   "id": "I‑04",
   "title": "Own وAssigned لحامل المفتاح",
   "text": "مَن يملك مفتاحَ العملية الكامل (قرارُ Phase 2.1) يعمل على سجلات غيره بالصلاحية → البُعدُ not_applicable؛ ويُقاس Own/Assigned لمسار الذات ولراصد الميدان (dailyFieldOnly) فقط — كما يفعل الخادمُ اليوم (selfTaskOnly · fieldObsOnly)."
  },
  {
   "id": "I‑05",
   "title": "DateRange في القراءة (D4‑01)",
   "text": "الأقفالُ الزمنية ونوافذُ الاستدراك تحكم الكتابة (D3‑07 · D4‑02 · D4‑03)؛ لا قيمةَ نطاقٍ زمنية للقراءة في v24.4/v24.5 ⇒ DateRange في evaluateRead = not_applicable (معلَن)."
  },
  {
   "id": "I‑06",
   "title": "قراءةُ موردٍ بلا مفتاح قراءة",
   "text": "السجلاتُ العامة (الإدارات · الحسابات بلا بصمات · الصلاحيات · المنصة · القطاعات) تُقرأ اليوم بكل جلسة ولا مفتاحَ guard.kind=read لها في السجل ⇒ not_applicable:no-read-key (يُحصى ولا يُعدّ اختلافاً)."
  }
 ],
 "conflicts": [
  {
   "id": "AC‑02",
   "title": "super ↔ closed-period (D3‑07)",
   "text": "Phase 4: D3‑07 لا يستثني مديرَ النظام من نافذة الاستدراك بينما v24.4 §7 يعطيه Global — أُعلن expected:AC‑02.",
   "status": "resolved",
   "decision": "D4‑03",
   "resolution": "الكتابةُ على فترةٍ مغلقة = CRUD ∧ Data Scope ∧ valid Retro Window لكل فاعلٍ بما فيه super؛ super يفتح النافذة بحكم D3‑01 (reason + audit) ثم يكتب داخلها. الظلُّ: بلا نافذة ⇒ expected:D4-03 super∧closed-period (no retro window) · مع نافذةٍ سارية ⇒ allow (DateRange)."
  }
 ],
