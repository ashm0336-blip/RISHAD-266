<sc-if value="{{tkOn}}" hint-placeholder-val="{{ true }}">
<div class="pf-card" data-pf-tasks="1">
  <div class="pf-head"><div style="flex:1;min-width:0"><b>مهامك</b><small>{{tkSub}}</small></div>
    <sc-if value="{{tkNewN}}" hint-placeholder-val="{{ false }}"><span class="pf-pill" style="background:var(--bg-xb45309);color:var(--fg-xffffff)">{{tkNewN}} جديدة</span></sc-if>
    <sc-if value="{{tkRunN}}" hint-placeholder-val="{{ false }}"><span class="pf-pill" style="background:var(--bg-a51501050p12);color:var(--fg-x047857)">● {{tkRunN}} جارية</span></sc-if>
    <sc-if value="{{tkRetN}}" hint-placeholder-val="{{ false }}"><span class="pf-pill" style="background:var(--danger-bg);color:var(--danger-text)">↺ {{tkRetN}} أُعيدت</span></sc-if>
    <sc-if value="{{tkRevN}}" hint-placeholder-val="{{ false }}"><span class="pf-pill" style="background:var(--info-bg);color:var(--info-text)">◔ {{tkRevN}} للمراجعة</span></sc-if>
  </div>
  <!-- KIVO_265 · البند 9: الطابورُ المحلي — ما حُفظ بلا اتصال وينتظر الإرسال · وما رفضه الخادم (لا يُعاد) -->
  <sc-if value="{{tkQOn}}" hint-placeholder-val="{{ false }}"><div data-tk-queue="1" style="margin:0 16px 10px;display:grid;gap:6px">
    <sc-if value="{{tkQPendOn}}" hint-placeholder-val="{{ true }}"><div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;border:1px solid var(--warning-border);background:var(--warning-bg);color:var(--warning-text);border-radius:11px;padding:8px 12px;font-size:11.5px;font-weight:700"><span style="flex:1;min-width:0">{{tkQTxt}}<small style="display:block;font-weight:400;font-size:10.5px">{{tkQSub}}</small></span><button class="tk-btn" style="min-width:0;padding:5px 11px" onClick="{{tkQSend}}" disabled="{{tkQSending}}">أرسل الآن</button></div></sc-if>
    <sc-for list="{{tkQFail}}" as="f" hint-placeholder-count="1"><div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;border:1px solid var(--danger-border);background:var(--danger-bg);color:var(--danger-text);border-radius:11px;padding:8px 12px;font-size:11.5px"><span style="flex:1;min-width:0"><b>{{f.t}}</b><small style="display:block;font-size:10.5px">{{f.why}}</small></span><button class="tk-btn" style="min-width:0;padding:5px 11px" onClick="{{f.drop}}">تجاهل</button></div></sc-for>
  </div></sc-if>
  <sc-if value="{{tkEmpty}}" hint-placeholder-val="{{ true }}">
  <div class="tk-empty" data-tk-noperm="{{tkNoPerm}}"><div class="tk-eic"><svg width="20" height="20" sc-camel-view-box="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" data-i="i-6ef6a961"></svg></div><b style="display:block;color:var(--fg-x141414);font-size:13px">{{tkEmptyT}}</b><div style="font-size:11px;margin-top:2px">{{tkEmptyS}}<sc-if value="{{tkRetryOn}}" hint-placeholder-val="{{ false }}"> <button class="pf-linkbtn" onClick="{{tkRetry}}">أعد المحاولة</button></sc-if></div></div>
  <sc-if value="{{tkRvOn}}" hint-placeholder-val="{{ false }}"><div class="tk-rows" data-tk-rv="1"><div class="tk-rowh">{{tkRvHead}}</div>
    <sc-for list="{{tkRv}}" as="q" hint-placeholder-count="1"><div class="tk-row" style="{{q.rowStyle}}" onClick="{{q.open}}"><span class="tk-ic" style="{{q.icoStyle}}">{{q.ico}}</span><div style="flex:1;min-width:0"><div style="font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{q.title}}</div><div style="font-size:10px;color:var(--fg-x94a3b8);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{q.meta}}</div></div><span class="pf-pill" style="{{q.pillStyle}}">{{q.pill}}</span></div></sc-for></div></sc-if>
  <sc-if value="{{tkStatsOn}}" hint-placeholder-val="{{ true }}">
  <div class="pf-stats" style="padding:10px 16px;border-top:1px solid var(--bd-xf1f5f9);font-size:11px"><span style="color:var(--fg-x94a3b8)">هذا الشهر:</span><span><b style="color:var(--fg-x059669)">{{tkMonDone}}</b> منجزة</span><span><b style="color:var(--fg-x047857)">{{tkMonOn}}</b> في الوقت</span><span><b style="color:var(--fg-xb45309)">{{tkMonLate}}</b> متأخرة</span><span><b style="color:var(--fg-x94a3b8)">{{tkMonDec}}</b> اعتذار</span><span onClick="{{tkLogOpen}}" style="margin-right:auto;color:var(--fg-xb99751);font-weight:800;cursor:pointer">سجل مهامك ←</span></div>
  </sc-if>
  </sc-if>
  <sc-if value="{{tkHas}}" hint-placeholder-val="{{ false }}">
  <div class="tk-sum"><div class="tk-m {{tkHotCls}}"><small>تنتظر البدء</small><b style="color:var(--fg-xb45309)">{{tkNewNz}}</b></div><div class="tk-m"><small>جارية</small><b style="color:var(--fg-x047857)">{{tkRunNz}}</b></div><div class="tk-m"><small>قادمة</small><b>{{tkUpN}}</b></div><div class="tk-m"><small>منجزة اليوم</small><b style="color:var(--fg-x059669)">{{tkDoneN}}</b></div></div>
  <sc-if value="{{tkFocusOn}}" hint-placeholder-val="{{ true }}">
  <div class="tk-f">
    <div class="tk-flbl" style="color:{{tkFLblC}}"><i></i>{{tkFLbl}}</div>
    <div class="tk-top"><span class="tk-ic" style="{{tkFIcoStyle}}">{{tkFIco}}</span><div style="flex:1;min-width:0"><div class="tk-t">{{tkFTitle}}</div><div class="tk-s">{{tkFMeta}}</div><sc-if value="{{tkFSub}}" hint-placeholder-val="{{ false }}"><div class="tk-s" style="color:{{tkFSubC}};font-weight:700">{{tkFSub}}</div></sc-if></div></div>
    <sc-if value="{{tkFNoteOn}}" hint-placeholder-val="{{ false }}"><div style="{{tkFNoteStyle}};border-radius:11px;padding:8px 12px;font-size:11.5px;font-weight:700;line-height:1.7">{{tkFNote}}</div></sc-if>
    <sc-if value="{{tkFQOn}}" hint-placeholder-val="{{ false }}"><div data-tk-fq="1" style="border:1px solid var(--warning-border);background:var(--warning-bg);color:var(--warning-text);border-radius:11px;padding:8px 12px;font-size:11.5px;font-weight:700;line-height:1.7">⏳ {{tkFQTxt}}</div></sc-if>
    <div class="tk-meta"><div class="tk-m"><small>{{tkFM1L}}</small><b>{{tkFM1V}}</b></div><div class="tk-m"><small>{{tkFM2L}}</small><b>{{tkFM2V}}</b></div><div class="tk-m"><small>{{tkFM3L}}</small><b style="color:{{tkFM3C}}">{{tkFM3V}}</b></div></div>
    <sc-if value="{{tkFTimerOn}}" hint-placeholder-val="{{ true }}"><div class="tk-timer" style="{{tkFTimerStyle}}"><div class="tk-big">{{tkFBig}}</div><div class="tk-tl"><b>{{tkFTimerL}}</b>{{tkFTimerS}}</div></div></sc-if>
    <div class="tk-bar"><i style="width:{{tkFBar}};background:{{tkFBarC}}"></i></div>
    <sc-if value="{{tkFProofOn}}" hint-placeholder-val="{{ false }}"><div class="tk-proof"><sc-for list="{{tkFProofImgs}}" as="im" hint-placeholder-count="1"><sc-if value="{{im.on}}" hint-placeholder-val="{{ true }}"><img class="tk-th" src="{{im.src}}" alt="صورة مرفقة"></sc-if><sc-if value="{{im.off}}" hint-placeholder-val="{{ false }}"><span class="tk-th"></span></sc-if></sc-for><div style="flex:1;min-width:0;font-size:10.5px;color:var(--fg-x64748b);line-height:1.7"><b style="color:var(--fg-x141414);display:block;font-size:11.5px">توثيقك: {{tkFProofN}}</b>{{tkFProofNote}}</div></div>
    <div style="font-size:10.5px;color:var(--fg-x64748b);display:flex;align-items:center;gap:6px"><span style="width:7px;height:7px;border-radius:50%;background:var(--bg-x059669);display:inline-block"></span>{{tkFProofMsg}}</div></sc-if>
    <sc-if value="{{tkFStartOn}}" hint-placeholder-val="{{ false }}"><div class="tk-btns" style="flex-wrap:wrap"><button class="tk-btn pri" style="min-width:96px" onClick="{{tkFAccept}}" disabled="{{tkFStartDis}}" title="{{tkFStartHint}}">{{tkFStartTxt}}</button><sc-if value="{{tkFAckOn}}" hint-placeholder-val="{{ false }}"><button class="tk-btn" style="min-width:96px" onClick="{{tkFAck}}">✓ استلمتُها</button></sc-if><sc-if value="{{tkFDecOn}}" hint-placeholder-val="{{ true }}"><button class="tk-btn ghost" style="min-width:96px" onClick="{{tkFDecline}}">اعتذار…</button></sc-if></div><sc-if value="{{tkFStartDis}}" hint-placeholder-val="{{ false }}"><div class="tk-s" style="color:var(--warning-text);font-weight:700;margin-top:4px">{{tkFStartHint}}</div></sc-if></sc-if>
    <sc-if value="{{tkFRun}}" hint-placeholder-val="{{ false }}"><div class="tk-btns" style="flex-wrap:wrap"><button class="tk-btn ok" style="min-width:96px" onClick="{{tkFFinish}}">{{tkFFinTxt}}</button><sc-if value="{{tkFResumeOn}}" hint-placeholder-val="{{ false }}"><button class="tk-btn" style="min-width:96px" onClick="{{tkFResume}}">▶ استئناف</button></sc-if><sc-if value="{{tkFStallOn}}" hint-placeholder-val="{{ false }}"><button class="tk-btn" style="min-width:96px;color:var(--warning-text)" onClick="{{tkFStall}}">تعثّر…</button></sc-if></div></sc-if>
    <div class="tk-steps"><sc-for list="{{tkFSteps}}" as="st" hint-placeholder-count="4"><div class="{{st.cls}}"><i></i>{{st.t}}</div></sc-for></div>
    <sc-if value="{{tkFTlOn}}" hint-placeholder-val="{{ false }}"><div style="display:flex;justify-content:flex-end"><span onClick="{{tkFTl}}" style="font-size:11px;color:var(--brand-text);font-weight:800;cursor:pointer;padding:6px 2px">سجل المهمة ←</span></div></sc-if>
  </div>
  </sc-if>
  <div class="tk-rows">
    <sc-if value="{{tkRestOn}}" hint-placeholder-val="{{ false }}"><div class="tk-rowh">بقية مهامك</div>
    <sc-for list="{{tkRest}}" as="q" hint-placeholder-count="2"><div class="tk-row" onClick="{{q.open}}"><span class="tk-ic" style="{{q.icoStyle}}">{{q.ico}}</span><div style="flex:1;min-width:0"><div style="font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{q.title}}</div><div data-tkq="{{q.key}}" style="font-size:10px;color:var(--fg-x94a3b8);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{q.meta}}</div></div><span class="pf-pill" style="{{q.pillStyle}}">{{q.pill}}</span></div></sc-for></sc-if>
    <sc-if value="{{tkRvOn}}" hint-placeholder-val="{{ false }}"><div class="tk-rowh" data-tk-rv="1">{{tkRvHead}}</div>
    <sc-for list="{{tkRv}}" as="q" hint-placeholder-count="1"><div class="tk-row" style="{{q.rowStyle}}" onClick="{{q.open}}"><span class="tk-ic" style="{{q.icoStyle}}">{{q.ico}}</span><div style="flex:1;min-width:0"><div style="font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{q.title}}</div><div style="font-size:10px;color:var(--fg-x94a3b8);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{q.meta}}</div></div><span class="pf-pill" style="{{q.pillStyle}}">{{q.pill}}</span></div></sc-for></sc-if>
    <div class="tk-foot"><span style="color:var(--fg-x94a3b8)">{{tkMoreTxt}}</span><span onClick="{{tkLogOpen}}" style="color:var(--fg-xb99751);font-weight:800;cursor:pointer">سجل مهامك ←</span></div>
  </div>
  </sc-if>
</div>
</sc-if>
