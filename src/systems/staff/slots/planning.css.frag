#bsPtRoot[data-ptab="sched"] .pt-tab.pt-sched{border-color:var(--tone-gold-50-a45);background:var(--bg-surface);box-shadow:0 3px 10px -4px rgba(138,111,53,0.45)}
#bsPtRoot[data-ptab="sched"] .pt-sched .pt-ico{background:var(--tone-gold-50-a10);color:var(--brand-fg)}
#bsPtRoot[data-ptab="sched"] .pt-sched .pt-lbl{font-weight:600;color:var(--brand-fg)}
#bsPtRoot[data-ptab="sched"] .pt-sched .pt-ul{display:block}
#bsPtRoot:not([data-ptab="sched"]) #bsPtSched{display:none}
#bsPtRoot[data-pton="sched"] .pt-strip{display:none}
#bsPtRoot:not([data-pton~="sched"]) .pt-sched{display:none}
