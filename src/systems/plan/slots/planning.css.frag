#bsPtRoot[data-ptab=plan] .pt-plan{border-color:var(--tone-gold-50-a45);background:var(--bg-surface);box-shadow:0 3px 10px -4px rgba(138,111,53,0.45)}
#bsPtRoot[data-ptab=plan] .pt-plan .pt-ico{background:var(--tone-gold-50-a10);color:var(--brand-fg)}
#bsPtRoot[data-ptab=plan] .pt-plan .pt-lbl{font-weight:600;color:var(--brand-fg)}
#bsPtRoot[data-ptab=plan] .pt-plan .pt-ul{display:block}
#bsPtRoot:not([data-ptab=plan]) #bsPtPlan,[data-pton=plan] .pt-strip,#bsPtRoot:not([data-pton~=plan]) .pt-plan{display:none}
