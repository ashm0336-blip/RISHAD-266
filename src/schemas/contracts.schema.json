{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "KIVO — عقودُ /api (src/api/contracts.json · SOT-123/SOT-127)",
 "type": "object",
 "required": [
  "version",
  "common",
  "routes"
 ],
 "properties": {
  "$schema_note": {
   "type": "string"
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "common": {
   "type": "object",
   "required": [
    "errors"
   ],
   "properties": {
    "errors": {
     "type": "object",
     "patternProperties": {
      "^[1-5][0-9][0-9]$": {
       "type": "object",
       "required": [
        "keys"
       ],
       "properties": {
        "keys": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "err": {
         "type": "string"
        }
       }
      }
     },
     "additionalProperties": false
    }
   }
  },
  "routes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "path",
     "methods",
     "access"
    ],
    "additionalProperties": false,
    "properties": {
     "path": {
      "type": "string",
      "pattern": "^/api/"
     },
     "prefix": {
      "type": "boolean"
     },
     "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
       "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
       ]
      }
     },
     "access": {
      "enum": [
       "public",
       "session",
       "actor",
       "super",
       "enforce"
      ]
     },
     "request": {
      "type": "object"
     },
     "query": {
      "type": "object"
     },
     "note": {
      "type": "string"
     },
     "responses": {
      "type": "object",
      "patternProperties": {
       "^[1-5][0-9][0-9]$": {
        "type": "object"
       }
      },
      "additionalProperties": false
     }
    }
   }
  }
 }
}
