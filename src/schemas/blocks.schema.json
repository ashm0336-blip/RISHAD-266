{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "KIVO · src/blocks.json — كتلُ البناء وترتيبُها والأصول والصفحات",
 "type": "object",
 "required": ["assets", "blocks", "pages", "gateBlock", "dcLogic", "dcLogicInline"],
 "properties": {
  "assets": {"type": "object", "additionalProperties": {"type": "object", "required": ["bytes", "enc", "mime", "prefix", "sha256"], "properties": {"bytes": {"type": "integer"}, "enc": {"type": "string"}, "mime": {"type": "string"}, "prefix": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
  "blocks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "openTag", "closeTag"], "properties": {"id": {"type": "string", "pattern": "^[a-z][A-Za-z0-9_./-]*\\.(js|css|html)$"}, "kind": {"type": "string", "enum": ["js", "css", "inline-js", "inline-css", "inline"]}, "openTag": {"type": "string"}, "closeTag": {"type": "string"}, "line": {"type": ["integer", "null"]}, "origBytes": {"type": ["integer", "null"]}, "origSha256": {"type": ["string", "null"]}}}},
  "pages": {"type": "object", "required": ["items", "order", "zlibLevel"], "properties": {"order": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "zlibLevel": {"type": "integer"}}},
  "gateBlock": {"type": "string"}, "dcLogic": {"type": "string", "enum": ["precompiled"]}, "dcLogicInline": {"type": "string", "enum": ["body-end", "head"]}
 }
}
