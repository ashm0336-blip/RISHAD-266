{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "KIVO · manifests/pages.json — سجلُّ الصفحات (ADR-010)",
 "type": "object", "additionalProperties": false,
 "required": ["version", "generated", "notes", "pages", "containers", "tabAddr", "navOrder", "navNames", "routeNames"],
 "properties": {
  "version": {"type": "integer", "minimum": 1}, "generated": {"type": "string"}, "notes": {"type": "array", "items": {"type": "string"}},
  "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
  "containers": {"type": "array", "items": {"type": "object", "required": ["key", "nav", "name", "refs", "names"], "additionalProperties": false,
    "properties": {"key": {"$ref": "#/$defs/key"}, "nav": {"$ref": "#/$defs/key"}, "name": {"type": "string", "minLength": 1}, "refs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*/[a-z][A-Za-z0-9]*$"}}, "names": {"type": "object", "additionalProperties": {"type": "string"}}}}},
  "tabAddr": {"type": "object", "additionalProperties": {"oneOf": [{"const": 1}, {"type": "object", "additionalProperties": {"const": 1}}]}},
  "navOrder": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true},
  "navNames": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
  "routeNames": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
 },
 "$defs": {
  "key": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
  "sub": {"type": "object", "required": ["key", "name"], "additionalProperties": false, "properties": {"key": {"$ref": "#/$defs/key"}, "name": {"type": "string", "minLength": 1}, "offPage": {"type": "boolean"}}},
  "tab": {"type": "object", "required": ["key", "name"], "additionalProperties": false, "properties": {"key": {"$ref": "#/$defs/key"}, "name": {"type": "string", "minLength": 1}, "offPage": {"type": "boolean"}}},
  "page": {"type": "object", "required": ["key", "nav", "name"], "additionalProperties": false,
   "properties": {"key": {"$ref": "#/$defs/key"}, "nav": {"$ref": "#/$defs/key"}, "name": {"type": "string", "minLength": 1}, "under": {"$ref": "#/$defs/key"}, "tabLabel": {"type": "string"},
     "seq": {"type": "array", "items": {"type": "string", "pattern": "^(sub|tab|page):[a-z][A-Za-z0-9]*$"}}, "subs": {"type": "array", "items": {"$ref": "#/$defs/sub"}}, "tabs": {"type": "array", "items": {"$ref": "#/$defs/tab"}}}}
 }
}
