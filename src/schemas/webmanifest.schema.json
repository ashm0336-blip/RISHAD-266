{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "KIVO — بيانُ التطبيق (src/manifests/manifest.webmanifest.json · SOT-123)",
 "type": "object",
 "required": [
  "name",
  "short_name",
  "start_url",
  "display",
  "icons"
 ],
 "properties": {
  "name": {
   "type": "string",
   "minLength": 1
  },
  "short_name": {
   "type": "string",
   "minLength": 1
  },
  "start_url": {
   "type": "string"
  },
  "scope": {
   "type": "string"
  },
  "display": {
   "enum": [
    "standalone",
    "fullscreen",
    "minimal-ui",
    "browser"
   ]
  },
  "dir": {
   "enum": [
    "rtl",
    "ltr",
    "auto"
   ]
  },
  "lang": {
   "type": "string"
  },
  "theme_color": {
   "type": "string",
   "pattern": "^#[0-9A-Fa-f]{3,8}$"
  },
  "background_color": {
   "type": "string",
   "pattern": "^#[0-9A-Fa-f]{3,8}$"
  },
  "icons": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "src",
     "sizes",
     "type"
    ],
    "properties": {
     "src": {
      "type": "string"
     },
     "sizes": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "purpose": {
      "type": "string"
     }
    }
   }
  }
 },
 "additionalProperties": false
}
