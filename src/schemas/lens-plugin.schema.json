{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "KIVO · plugins/lenses/<key>/manifest.json — عدسةٌ كإضافة (AUD-030 · SOT-089 · ADR-018)",
 "description": "المفاتيحُ (من السجلّ) · الموارد (عمودُ عناصر أو حقولٌ فوق العناصر/الطابق) · الحرّاس (بوابةُ التفعيل والموارد المحروسة) · الاختبارات. الواجهةُ والخادمُ يأخذان قائمةَ العدسات ومواردَها من هذه الملفات بالتوليد (tools/generate.py) — إضافةُ عدسةٍ لا تمسّ كودَ 33x ولا الخادم.",
 "type": "object", "additionalProperties": false,
 "required": ["schema", "kind", "key", "name", "label", "order", "owner", "hosts", "keys", "resources", "guards", "tests"],
 "properties": {
  "schema": {"const": 1},
  "kind": {"const": "lens"},
  "key": {"type": "string", "pattern": "^[a-z]{2,12}$"},
  "name": {"type": "string", "minLength": 2},
  "label": {"type": "string", "minLength": 2},
  "order": {"type": "integer", "minimum": 1},
  "owner": {"type": "string", "pattern": "^lens\\.[a-z]{2,12}$"},
  "hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z]+(/[A-Za-z]+)?$"}},
  "keys": {"type": "object", "additionalProperties": false, "required": ["own", "managedRefs", "reserved"],
   "properties": {
    "own": {"$ref": "#/$defs/keyList"}, "managedRefs": {"$ref": "#/$defs/keyList"}, "reserved": {"$ref": "#/$defs/keyList"}}},
  "resources": {"type": "object", "additionalProperties": false,
   "properties": {
    "column": {"type": "object", "additionalProperties": false, "required": ["name", "seq", "identity", "geometry", "editKey", "status"],
     "properties": {
      "name": {"type": "string", "pattern": "^[a-z]{2,12}$"}, "seq": {"type": "integer", "minimum": 1},
      "hideFlag": {"type": "string", "pattern": "^hide[A-Z][A-Za-z]+$"},
      "identity": {"type": "string", "pattern": "^builtin:[a-z]+$"},
      "geometry": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "derived": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "editKey": {"$ref": "#/$defs/key"},
      "status": {"type": "object", "additionalProperties": false, "required": ["fields", "op"],
       "properties": {"fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "op": {"$ref": "#/$defs/key"}}}}},
    "elementFields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["cols", "fields", "op"],
     "properties": {"cols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,12}$"}},
                    "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}},
                    "op": {"$ref": "#/$defs/key"}}}},
    "floorFields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "op"],
     "properties": {"field": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "op": {"$ref": "#/$defs/key"}}}},
    "indicators": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z]+/[A-Za-z]+$"}, "uniqueItems": true}}},
  "guards": {"type": "object", "additionalProperties": false, "required": ["enable", "resources"],
   "properties": {"enable": {"$ref": "#/$defs/key"},
                  "resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["bassam_plan_v1", "bassam_rounds_v1"]}}}},
  "tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(tests|cfbench)/[A-Za-z0-9_./-]+\\.(mjs|py)$"}}
 },
 "$defs": {
  "key": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"},
  "keyList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}
 }
}
